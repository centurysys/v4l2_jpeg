# Package

version       = "0.1.0"
author        = "Takeyoshi Kikuchi"
description   = "High-performance JPEG encoding for Nim using hardware V4L2 M2M encoders, with an API inspired by TurboJPEG."
license       = "MIT"
srcDir        = "src"


# Dependencies

requires "nim >= 2.2.8"
requires "results >= 0.5.1"
